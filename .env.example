# ─── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Finanzas"
# URL pública de la app (para armar los links de invitación)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secreto para firmar la cookie de sesión (>= 32 chars aleatorios).
# Generá uno: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ─── Base de datos: Neon (Postgres) ────────────────────
# neon.tech → crear proyecto → Connection string (pooled)
DATABASE_URL="postgresql://user:password@ep-xxx.sa-east-1.aws.neon.tech/finances?sslmode=require"

# ─── Firebase Auth ─────────────────────────────────────
# Firebase console → Project settings → tus apps → Web app → SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Solo se usa para validar el issuer/audience del ID token (mismo que el de arriba)
FIREBASE_PROJECT_ID=""

# ─── Telegram bot (carga de gastos por chat) ───────────
# @BotFather → /newbot → copiá el token y el @usuario del bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Secreto que Telegram manda en cada webhook (lo elegís vos, >= 16 chars).
# node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=""

# ─── Gemini (parseo de los mensajes de Telegram) ───────
# https://aistudio.google.com/apikey  (tier gratuito)
GEMINI_API_KEY=""
# Opcional: modelo a usar. Default: gemini-3.6-flash
# GEMINI_MODEL=""

# ─── Cron (aviso de vencimiento de resúmenes de tarjeta) ─
# Secreto para autenticar el cron diario. >= 16 chars aleatorios.
# Vercel lo manda como "Authorization: Bearer <CRON_SECRET>".
# node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CRON_SECRET=""
