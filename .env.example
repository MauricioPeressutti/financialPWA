# ─── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Finanzas"
# URL pública de la app (para armar los links de invitación)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Base de datos: Neon (Postgres) ────────────────────
# neon.tech → crear proyecto → Connection string (pooled)
DATABASE_URL="postgresql://user:password@ep-xxx.sa-east-1.aws.neon.tech/finances?sslmode=require"

# ─── Firebase Auth ─────────────────────────────────────
# Firebase console → Project settings → tus apps → Web app → SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Admin SDK (server) — Firebase console → Project settings → Service accounts
# → Generate new private key. Pegar los 3 valores del JSON:
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# La private key va entre comillas, con los \n literales
FIREBASE_PRIVATE_KEY=""
