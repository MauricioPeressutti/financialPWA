# ─── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Finanzas"

# ─── Base de datos (Fase 2) ────────────────────────────
# Local: postgres corriendo en Docker o Cloud SQL Auth Proxy.
# En Cloud Run se conecta por unix socket: /cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL="postgresql://user:password@localhost:5432/finances"

# ─── Firebase Auth (Fase 1) ────────────────────────────
# Config pública del cliente web (Firebase console → Project settings → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Credencial del Admin SDK para verificar ID tokens en el server.
# En Cloud Run usa la service account por defecto (no hace falta el JSON).
# En local: ruta al JSON de una service account con rol "Firebase Authentication Admin".
GOOGLE_APPLICATION_CREDENTIALS=""
FIREBASE_PROJECT_ID=""
